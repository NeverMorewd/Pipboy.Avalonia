<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource PipboyThicknessNone}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="MenuItem">
                    <Panel>

                        <!--  ── Visible row ──  -->
                        <Border
                            Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ToggleIcon" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemChevron" />
                                </Grid.ColumnDefinitions>

                                <ContentControl
                                    Name="PART_ToggleIconPresenter"
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="{DynamicResource MenuItemIconMargin}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsVisible="False" />

                                <!--  Icon  -->
                                <ContentPresenter
                                    Grid.Column="1"
                                    Width="14"
                                    Height="14"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Icon}" />
                                <!--  Header  -->
                                <ContentPresenter
                                    Name="PART_HeaderPresenter"
                                    Grid.Column="2"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    RecognizesAccessKey="True" />
                                <!--  Input gesture hint (Ctrl+S etc.)  -->
                                <TextBlock
                                    Name="PART_InputGestureText"
                                    Grid.Column="3"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PipboyTextDimBrush}"
                                    Text="{TemplateBinding InputGesture}" />
                                <!--  Submenu chevron — hidden via :empty when no children  -->
                                <Path
                                    Name="PART_SubMenuArrow"
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 4 5 L 9 8 L 4 11"
                                    Stroke="{DynamicResource PipboyTextDimBrush}"
                                    StrokeThickness="{DynamicResource PipboyIconStrokeThickness}" />
                            </Grid>
                        </Border>

                        <!--  ── PART_Popup: submenu (required by MenuItem control) ──  -->
                        <Popup
                            Name="PART_Popup"
                            HorizontalOffset="2"
                            InheritsTransform="True"
                            IsLightDismissEnabled="False"
                            IsOpen="{TemplateBinding IsSubMenuOpen,
                                                     Mode=TwoWay}"
                            Placement="RightEdgeAlignedTop"
                            VerticalOffset="-3"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Padding="0,2"
                                Background="{DynamicResource PipboySurfaceBrush}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource PipboyCornerRadiusNone}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>

                    </Panel>
                </ControlTemplate>
            </Setter>

            <!--  Hover  -->
            <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
            </Style>
            <!--  Pressed (only when pointer is still over the row, not a child submenu)  -->
            <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
                <Setter Property="Background" Value="{DynamicResource PipboyPressedBrush}" />
            </Style>
            <!--  Open: submenu is expanded  -->
            <Style Selector="^:open /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource PipboySelectionBrush}" />
            </Style>
            <!--  :empty = MenuItem has no sub-items → hide the chevron  -->
            <Style Selector="^:empty /template/ Path#PART_SubMenuArrow">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <!--  Disabled  -->
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="{DynamicResource PipboyDisabledOpacity}" />
            </Style>
            <Style Selector="^:separator">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Separator />
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Content">
                    <Template>
                        <PathIcon
                            Width="14"
                            Height="14"
                            Data="M 5.25,9.43 L 2.82,7.00 L 2.00,7.82 L 5.25,11.08 L 12.25,4.08 L 11.43,3.26 Z"
                            Foreground="{Binding $parent[MenuItem].Foreground}" />
                    </Template>
                </Setter>
            </Style>

            <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Content">
                    <Template>
                        <Ellipse
                            Width="6"
                            Height="6"
                            Margin="4"
                            Fill="{Binding $parent[MenuItem].Foreground}" />
                    </Template>
                </Setter>
            </Style>
        </ControlTheme>

        <!--
            ═══════════════════════════════════════════════════════════════════════
            TopLevelMenuItem  —  used only for direct children of a Menu bar.
            Key differences vs regular MenuItem:
            • Popup opens downward (BottomEdgeAlignedLeft) not rightward
            • IsLightDismissEnabled="True" so clicking elsewhere closes it
            • OverlayInputPassThroughElement lets clicks on sibling menu items work
            • No icon column, no gesture hint, no chevron (top-level has no parent)
            ═══════════════════════════════════════════════════════════════════════
        -->
        <ControlTheme x:Key="TopLevelMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource PipboyThicknessNone}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="MenuItem">
                    <Panel>

                        <Border
                            Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Name="PART_HeaderPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                RecognizesAccessKey="True" />
                        </Border>

                        <!--  Dropdown popup — opens below the menu bar item  -->
                        <Popup
                            Name="PART_Popup"
                            MinWidth="{Binding $parent[MenuItem].Bounds.Width}"
                            InheritsTransform="True"
                            IsLightDismissEnabled="True"
                            IsOpen="{TemplateBinding IsSubMenuOpen,
                                                     Mode=TwoWay}"
                            OverlayInputPassThroughElement="{Binding $parent[Menu]}"
                            Placement="BottomEdgeAlignedLeft"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Padding="0,2"
                                Background="{DynamicResource PipboySurfaceBrush}"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource PipboyCornerRadiusNone}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>

                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
            </Style>
            <!--  :selected = keyboard-focused in the menu bar  -->
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
            </Style>
            <!--  :open = dropdown is visible  -->
            <Style Selector="^:open /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource PipboySelectionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PipboyPrimaryBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="{DynamicResource PipboyDisabledOpacity}" />
            </Style>
        </ControlTheme>

        <!--
            ═══════════════════════════════════════════════════════════════════════
            Menu bar  (horizontal strip at the top of a window / panel)
            TopLevelMenuItem is applied to direct children so they drop downward.
            ═══════════════════════════════════════════════════════════════════════
        -->
        <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource PipboySurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PipboyBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource PipboyThicknessBottom}" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource TopLevelMenuItem}" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Menu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            Margin="{TemplateBinding Padding}"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
