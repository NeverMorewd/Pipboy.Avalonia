<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Height="500" Padding="20">
            <StackPanel VerticalAlignment="Center" Spacing="20">
                <DatePicker />
                <DatePicker CornerRadius="10" />
                <DatePicker IsEnabled="False" />
                <DatePicker>
                    <DataValidationErrors.Error>
                        <sys:Exception>
                            <x:Arguments>
                                <x:String>Error</x:String>
                            </x:Arguments>
                        </sys:Exception>
                    </DataValidationErrors.Error>
                </DatePicker>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    <Styles.Resources>

        <ControlTheme x:Key="{x:Type DatePickerPresenter}" TargetType="DatePickerPresenter">
            <Setter Property="Width" Value="296" />
            <Setter Property="MinWidth" Value="296" />
            <Setter Property="MaxHeight" Value="300" />
            <Setter Property="Background" Value="{DynamicResource PipboySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PipboyPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate TargetType="DatePickerPresenter">
                    <Border
                        Name="Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid RowDefinitions="*,1,Auto">

                            <!--  PART_PickerContainer: columns set dynamically by Avalonia code — NO ColumnDefinitions here  -->
                            <Grid
                                Name="PART_PickerContainer"
                                Grid.Row="0"
                                Height="240">

                                <!--  Month host — Grid rows give bounded height to ScrollViewer  -->
                                <Grid Name="PART_MonthHost">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton
                                        Name="PART_MonthUpButton"
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▲"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            Name="PART_MonthSelector"
                                            ItemHeight="{DynamicResource PipboyPickerItemHeight}"
                                            PanelType="Month"
                                            ShouldLoop="True" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Name="PART_MonthDownButton"
                                        Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▼"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                </Grid>

                                <Rectangle
                                    Name="PART_FirstSpacer"
                                    Grid.Column="1"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource PipboyBorderBrush}" />

                                <!--  Day host  -->
                                <Grid Name="PART_DayHost" Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton
                                        Name="PART_DayUpButton"
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▲"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            Name="PART_DaySelector"
                                            ItemHeight="{DynamicResource PipboyPickerItemHeight}"
                                            PanelType="Day"
                                            ShouldLoop="True" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Name="PART_DayDownButton"
                                        Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▼"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                </Grid>

                                <Rectangle
                                    Name="PART_SecondSpacer"
                                    Grid.Column="3"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource PipboyBorderBrush}" />

                                <!--  Year host  -->
                                <Grid Name="PART_YearHost" Grid.Column="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="{DynamicResource PipboyPickerRowHeight}" />
                                    </Grid.RowDefinitions>
                                    <RepeatButton
                                        Name="PART_YearUpButton"
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▲"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            Name="PART_YearSelector"
                                            ItemHeight="{DynamicResource PipboyPickerItemHeight}"
                                            PanelType="Year"
                                            ShouldLoop="False" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Name="PART_YearDownButton"
                                        Grid.Row="2"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="▼"
                                        Opacity="{DynamicResource PipboyDimOpacity}" />
                                </Grid>

                            </Grid>

                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Fill="{DynamicResource PipboyBorderBrush}" />

                            <!--  Accept / Dismiss  -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                                <Button
                                    Name="PART_AcceptButton"
                                    Grid.Column="0"
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    Content="OK" />
                                <Rectangle
                                    Grid.Column="1"
                                    Width="1"
                                    Fill="{DynamicResource PipboyBorderBrush}" />
                                <Button
                                    Name="PART_DismissButton"
                                    Grid.Column="2"
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    Content="CANCEL" />
                            </Grid>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type DatePicker}" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource PipboySurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PipboyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate TargetType="DatePicker">
                    <DataValidationErrors>
                        <Grid ColumnDefinitions="*,Auto">
                            <Button
                                Name="PART_FlyoutButton"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="8,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <!--  PART_ButtonContentGrid: columns set by Avalonia code  -->
                                <Grid Name="PART_ButtonContentGrid" ColumnDefinitions="78*,Auto,132*,Auto,78*">
                                    <TextBlock
                                        Name="PART_DayTextBlock"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PipboyTextDimBrush}" />
                                    <Rectangle
                                        Name="PART_FirstSpacer"
                                        Grid.Column="1"
                                        Width="1"
                                        HorizontalAlignment="Center"
                                        Fill="{DynamicResource PipboyBorderBrush}" />
                                    <TextBlock
                                        Name="PART_MonthTextBlock"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PipboyTextDimBrush}" />
                                    <Rectangle
                                        Name="PART_SecondSpacer"
                                        Grid.Column="3"
                                        Width="1"
                                        HorizontalAlignment="Center"
                                        Fill="{DynamicResource PipboyBorderBrush}" />
                                    <TextBlock
                                        Name="PART_YearTextBlock"
                                        Grid.Column="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PipboyTextDimBrush}" />
                                </Grid>
                            </Button>

                            <Popup
                                Name="PART_Popup"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsLightDismissEnabled="True"
                                Placement="BottomEdgeAlignedLeft"
                                PlacementTarget="PART_FlyoutButton"
                                WindowManagerAddShadowHint="False">
                                <DatePickerPresenter Name="PART_PickerPresenter" />
                            </Popup>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Button#PART_FlyoutButton">
                <Setter Property="BorderBrush" Value="{DynamicResource PipboyPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="{DynamicResource PipboyDisabledOpacity}" />
            </Style>
            <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PipboyTextDimBrush}" />
            </Style>
        </ControlTheme>

    </Styles.Resources>
</Styles>
