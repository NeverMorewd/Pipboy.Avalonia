<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pipboy="clr-namespace:Pipboy.Avalonia.Controls">
    <Styles.Resources>
        <!--
            Explicit ControlTheme for chrome buttons in PipboyWindow title bar.
            Applied via Theme="{StaticResource ChromeButtonTheme}" to guarantee
            the theme is resolved without an implicit lookup that can silently fail.
        -->
        <ControlTheme x:Key="ChromeButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextDimBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource PipboyPressedBrush}" />
            </Style>
        </ControlTheme>

        <!--  Close button: accent fill on hover  -->
        <ControlTheme x:Key="ChromeCloseButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextDimBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource PipboyHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PipboyPrimaryBrush}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource PipboyPressedBrush}" />
            </Style>
        </ControlTheme>

        <!--
            PipboyWindow ControlTheme — all title bar UI is INLINE here.
            No dependency on PipboyTitleBar ControlTheme lookup (which can fail
            when created inside another control's template).
            Interactions are wired in PipboyWindow.OnApplyTemplate via PART_* names.
        -->
        <ControlTheme x:Key="{x:Type pipboy:PipboyWindow}" TargetType="pipboy:PipboyWindow">
            <Setter Property="Background" Value="{DynamicResource PipboyBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PipboyTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource PipboyFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource PipboyFontSize}" />
            <Setter Property="Template">
                <ControlTemplate TargetType="pipboy:PipboyWindow">
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Panel Margin="{TemplateBinding WindowDecorationMargin}" Background="Transparent" />
                        <VisualLayerManager>
                            <DockPanel>

                                <!--  ── Inline title bar  ──  -->
                                <Border
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="{DynamicResource PipboyPrimaryDarkBrush}"
                                    BorderBrush="{DynamicResource PipboyBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    DockPanel.Dock="Top">
                                    <Grid ColumnDefinitions="*,Auto,Auto">

                                        <!--  Drag area (icon + title)  -->
                                        <Border
                                            Name="PART_TitleDragArea"
                                            Grid.Column="0"
                                            Padding="12,0,8,0"
                                            Background="Transparent"
                                            Cursor="SizeAll">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <!--  Title bar icon: shows window icon when set, else Pip-Boy green square  -->
                                                <Image
                                                    Name="PART_TitleBarIcon"
                                                    Margin="0,6"
                                                    VerticalAlignment="Stretch"
                                                    IsVisible="{TemplateBinding TitleBarIcon,
                                                                                Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                                    Source="{TemplateBinding TitleBarIcon}"
                                                    Stretch="Uniform" />
                                                <Border
                                                    Width="8"
                                                    Height="8"
                                                    Background="{DynamicResource PipboyPrimaryBrush}"
                                                    IsVisible="{TemplateBinding TitleBarIcon,
                                                                                Converter={x:Static ObjectConverters.IsNull}}" />
                                                <!--  Title  -->
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{DynamicResource PipboyFontSizeSmall}"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource PipboyTextBrush}"
                                                    Text="{TemplateBinding Title}" />
                                            </StackPanel>
                                        </Border>

                                        <!--  Extra title bar content — right-aligned, beside system buttons  -->
                                        <ContentPresenter
                                            Grid.Column="1"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding TitleBarContent}"
                                            IsVisible="{TemplateBinding TitleBarContent,
                                                                        Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <!--  System buttons  -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Stretch"
                                            Orientation="Horizontal">
                                            <Button
                                                Name="PART_MinimizeButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Content="─"
                                                Theme="{StaticResource ChromeButtonTheme}" />
                                            <Button
                                                Name="PART_MaxRestoreButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Content="□"
                                                Theme="{StaticResource ChromeButtonTheme}" />
                                            <Button
                                                Name="PART_CloseButton"
                                                Height="{TemplateBinding TitleBarHeight}"
                                                Content="✕"
                                                Theme="{StaticResource ChromeCloseButtonTheme}" />
                                        </StackPanel>

                                    </Grid>
                                </Border>

                                <!--  Window content  -->
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                            </DockPanel>
                        </VisualLayerManager>
                    </Panel>
                </ControlTemplate>
            </Setter>

            <!--  Maximized: swap □ → ❐  -->
            <Style Selector="^:maximized /template/ Button#PART_MaxRestoreButton">
                <Setter Property="Content" Value="❐" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
