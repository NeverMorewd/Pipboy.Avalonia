<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Pipboy.Avalonia.AvaloniaEdit</RootNamespace>
		<AssemblyName>Pipboy.Avalonia.AvaloniaEdit</AssemblyName>
		<PackageId>Pipboy.Avalonia.AvaloniaEdit</PackageId>
		<PackageIcon>pip-terminal.png</PackageIcon>
		<Version>1.0.0</Version>
		<Authors>Dong</Authors>
		<Description>The AvaloniaEdit theme library basedon Pipboy.Avalonia UI theme.</Description>
		<PackageTags>avalonia;theme;fallout;pipboy;retro;ui;dark-theme;avaloniaedit</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/NeverMorewd/Pipboy.Avalonia</RepositoryUrl>
		<PackageProjectUrl>https://github.com/NeverMorewd/Pipboy.Avalonia</PackageProjectUrl>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\pip-terminal.png" Pack="true" PackagePath="\" Link="Properties\pip-terminal.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="PipboyAvaloniaEditTheme.axaml.cs">
			<DependentUpon>PipboyAvaloniaEditTheme.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
	
    <ItemGroup>
	    <PackageReference Include="Avalonia" Version="12.0.1" />
	    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Pipboy.Avalonia\Pipboy.Avalonia.csproj" />
    </ItemGroup>
</Project>