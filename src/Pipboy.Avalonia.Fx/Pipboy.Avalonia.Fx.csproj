<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
	  <RootNamespace>Pipboy.Avalonia.Fx</RootNamespace>
	  <AssemblyName>Pipboy.Avalonia.Fx</AssemblyName>
	  <PackageId>Pipboy.Avalonia.Fx</PackageId>
	  <Version>1.0.0</Version>
	  <PackageIcon>..\..\pip-terminal.png</PackageIcon>
	  <Authors>Dong</Authors>
	  <Description>The effects and custom controls extension library basedon Pipboy.Avalonia UI theme.</Description>
	  <PackageTags>avalonia;pipboy;fallout;fx;effects;custom-controls;widgets;skia;retro</PackageTags>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/NeverMorewd/Pipboy.Avalonia</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/NeverMorewd/Pipboy.Avalonia</PackageProjectUrl>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\pip-terminal.png" Link="Properties\pip-terminal.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pipboy.Avalonia\Pipboy.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="PipboyFxTheme.axaml.cs">
      <DependentUpon>PipboyFxTheme.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
